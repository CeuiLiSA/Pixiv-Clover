<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <import type="ceui.lisa.slinky.ui.novel.NovelOneLineTextHolder" />

        <variable
            name="holder"
            type="NovelOneLineTextHolder" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            style="@style/textShippori"
            android:layout_marginHorizontal="@dimen/default_content_horizontal_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@{holder.text}"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </FrameLayout>
</layout>