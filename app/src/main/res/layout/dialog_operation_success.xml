<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_dialog"
    android:orientation="vertical"
    android:paddingVertical="40dp">

    <TextView
        style="@style/textNippon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="70dp"
        android:background="@drawable/background_congrats"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:paddingBottom="4dp"
        android:text="@string/succeed"
        android:textColor="@color/congratsTextYellow"
        android:textSize="24sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-30dp"
        android:layout_marginBottom="-30dp"
        android:scaleType="centerInside"
        android:src="@drawable/icon_reset_done" />

    <ceui.lisa.slinky.styles.ProgressTextButton
        android:id="@+id/ok_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="40dp"
        android:background="@drawable/bg_button_green_large"
        android:gravity="center"
        android:stateListAnimator="@animator/button_press_alpha"
        android:text="@string/ok"
        android:textColor="@color/button_text_color_green"
        android:textSize="17sp" />

</LinearLayout>

