<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <ceui.lisa.slinky.ui.InsetLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            app:layout_inset_adjust_margin="top"
            android:layout_height="match_parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                app:layout_constraintTop_toBottomOf="@+id/header_layout"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <ceui.lisa.slinky.styles.SlinkyBottomBar
                android:id="@+id/bottom_bar"
                app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"
                android:layout_marginBottom="12dp"
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>


        <LinearLayout
            android:id="@+id/header_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_inset_adjust_margin="top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/user_snap_layout"
                    layout="@layout/item_user_snap" />

                <ImageView
                    android:id="@+id/end_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="@dimen/default_content_horizontal_margin"
                    android:src="@drawable/ic_search" />

            </FrameLayout>

        </LinearLayout>





    </ceui.lisa.slinky.ui.InsetLayout>

</layout>