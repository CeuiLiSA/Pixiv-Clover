<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="user"
            type="androidx.lifecycle.LiveData&lt;ceui.lisa.slinky.models.User>" />
    </data>

    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="@dimen/user_horizontal_height"
        android:id="@+id/user_frame"
        android:stateListAnimator="@animator/button_press_alpha"
        android:gravity="center"
        android:orientation="vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/user_head"
            loadUserHead="@{user}"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginBottom="6dp"
            app:civ_border_color="@color/white"
            app:civ_border_width="1dp" />

        <TextView
            style="@style/textNippon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{user.name}"
            android:textColor="@color/white"
            android:textSize="13sp" />

    </LinearLayout>
</layout>