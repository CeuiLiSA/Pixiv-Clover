<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="ceui.lisa.slinky.ui.GlideState"/>
        <variable
            name="item"
            type="ceui.lisa.slinky.ui.SingleIllustHolder" />
    </data>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/image_background">

        <FrameLayout
            android:id="@+id/resize_frame_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <ImageView
                android:id="@+id/blur_image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/image_dimmer" />

        </FrameLayout>

        <ImageView
            android:id="@+id/image_view"
            android:layout_width="match_parent"
            visibleOrInvisible="@{item.progressListener.glideState == GlideState.FINISHED}"
            android:layout_height="230dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_circular_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            visibleOrGone="@{item.progressListener.glideState == GlideState.LOADING}"
            liveProgress="@{item.progressListener.progressLiveData}"
            android:layout_gravity="center"
            android:padding="10dp"
            app:indicatorColor="@color/white"
            app:indicatorSize="30dp"
            app:trackColor="@color/voice_record_track_color"
            app:trackCornerRadius="4dp"
            app:trackThickness="5dp" />

        <TextView
            style="@style/textNippon"
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            visibleOrGone="@{item.progressListener.glideState == GlideState.FAILED}"
            android:layout_marginBottom="12dp"
            android:background="@drawable/refresh_button_background"
            android:gravity="center"
            android:minHeight="0dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:stateListAnimator="@animator/button_press_alpha"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="@color/colorWhite40"
            android:textSize="15sp"
            android:visibility="gone" />

        <ceui.lisa.slinky.styles.ProgressImageButton
            android:id="@+id/play_gif"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="end|bottom"
            android:src="@drawable/icon_button_play_gif"
            android:stateListAnimator="@animator/button_press_alpha" />

        <ProgressBar
            android:id="@+id/gif_download_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:max="100"
            android:layout_gravity="bottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="加载中"
            android:visibility="gone"
            visibleOrGone="@{item.progressListener.glideState == GlideState.LOADING}"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="加载失败"
            android:visibility="gone"
            visibleOrGone="@{item.progressListener.glideState == GlideState.FAILED}"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="加载成功"
            android:visibility="gone"
            visibleOrGone="@{item.progressListener.glideState == GlideState.FINISHED}"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</layout>