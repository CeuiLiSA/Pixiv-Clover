<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/default_content_horizontal_margin"
        android:layout_marginVertical="6dp"
        android:orientation="horizontal">

        <com.kproduce.roundcorners.RoundImageView
            app:rRadius="6dp"
            android:id="@+id/image_view"
            android:background="@drawable/image_place_holder"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="centerInside">

        </com.kproduce.roundcorners.RoundImageView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    style="@style/textNippon"
                    android:id="@+id/index"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="21sp" />

                <TextView
                    style="@style/textNippon"
                    android:id="@+id/url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="@color/colorWhite80"
                    android:textSize="12sp" />


            </LinearLayout>

            <ImageView
                android:id="@+id/download"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_menu_save"
                android:stateListAnimator="@animator/button_press_alpha"
                app:tint="@color/colorButtonBlue">

            </ImageView>

        </FrameLayout>

    </LinearLayout>
</layout>