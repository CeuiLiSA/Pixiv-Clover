<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <ceui.lisa.slinky.ui.InsetLayout
        android:layout_width="match_parent"
        android:background="@color/black"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        </FrameLayout>

        <ceui.lisa.slinky.styles.ProgressTextButton
            android:id="@+id/save"
            style="@style/GreenShiningButton"
            app:layout_inset_adjust_margin="bottom"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:paddingHorizontal="16dp"
            app:ptb_progress_stroke_width="3dp"
            app:ptb_progress_width="14dp" />

    </ceui.lisa.slinky.ui.InsetLayout>
</layout>