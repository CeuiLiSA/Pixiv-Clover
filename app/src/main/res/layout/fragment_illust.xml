<?xml version="1.0" encoding="utf-8"?>
<ceui.lisa.slinky.ui.InsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        app:layout_inset_adjust_margin="bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        </androidx.recyclerview.widget.RecyclerView>

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:background="@drawable/illust_header_gradient"
        android:layout_height="80dp"/>

    <FrameLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </FrameLayout>

    <LinearLayout
        android:id="@+id/go_to_series"
        android:layout_width="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:layout_marginBottom="60dp"
        android:background="@drawable/button_go_series_bg"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:paddingVertical="8dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="6dp"
            android:includeFontPadding="false"
            android:text="Series"
            style="@style/textMontserratBold"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_height="wrap_content"/>

        <ImageView
            android:src="@drawable/icon_go_bottom"
            android:layout_marginEnd="12dp"
            android:rotation="-90"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scroll_to_bottom"
        android:layout_width="wrap_content"
        android:layout_gravity="end|bottom"
        android:gravity="center_vertical"
        android:layout_marginBottom="60dp"
        android:background="@drawable/button_go_bottom_bg"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@drawable/icon_go_bottom"
            android:layout_marginEnd="4dp"
            android:layout_marginStart="12dp"
            android:layout_width="20dp"
            android:layout_height="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:paddingVertical="8dp"
            android:layout_marginEnd="10dp"
            android:includeFontPadding="false"
            android:text="bottom"
            style="@style/textMontserratBold"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_height="wrap_content"/>
    </LinearLayout>


    <include
        android:id="@+id/item_loading"
        layout="@layout/item_loading"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <include
        android:id="@+id/deleted_frame"
        layout="@layout/deleted_frame_layout"/>

</ceui.lisa.slinky.ui.InsetLayout>