<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <ceui.lisa.slinky.ui.InsetLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/dialog_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/mercury_alert_bg"
            android:divider="@drawable/alert_button_divider"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                style="@style/textNippon"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/default_content_horizontal_margin"
                android:layout_marginVertical="14dp"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <TextView
                style="@style/textNippon"
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/default_content_horizontal_margin"
                android:layout_marginVertical="24dp"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <include
                android:id="@+id/sure_layout"
                layout="@layout/alert_button" />

            <include
                android:id="@+id/cancel_layout"
                layout="@layout/alert_button" />

        </LinearLayout>

    </ceui.lisa.slinky.ui.InsetLayout>

</layout>