<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true" android:state_activated="false">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFB700"/>
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:state_enabled="false" android:state_activated="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/disabled_button"/>
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:state_enabled="true"  android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/disabled_button"/>
            <stroke
                android:color="#66FFFFFF"
                android:width="@dimen/hair_line_width"/>
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
