<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true" android:state_selected="false">
        <shape android:shape="rectangle">
            <solid android:color="#00BBFE"/>
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/disabled_button"/>
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item
        android:state_enabled="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#260FCEFF"/>
            <corners android:radius="22dp" />
            <stroke
                android:color="#660FCEFF"
                android:width="1dp"/>
        </shape>
    </item>
</selector>
